{
  "name": "nodd",
  "version": "0.1.0",
  "description": "Fast, GPU-accelerated minimalist HTTP client and API workbench built with GPUIX",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot app.tsx",
    "build": "bun build --compile app.tsx --outfile dist/nodd",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gpuix/react": "0.11.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
